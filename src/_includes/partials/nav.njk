<nav class="bg-milwaukee-black text-white sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center h-20">
            <div class="flex-shrink-0">
                <a href="/" class="text-2xl font-bold text-milwaukee-red tracking-tight">ADROIT SERVICES</a>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center space-x-8">
                {% for item in navigation.main %}
                {% if item.children %}
                <!-- Dropdown Menu -->
                <div class="relative group">
                    <a href="{{ item.url }}" class="flex items-center hover:text-milwaukee-red transition-colors py-2">
                        {{ item.label }}
                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </a>
                    <div class="absolute left-0 mt-0 w-56 bg-milwaukee-black border border-milwaukee-gray rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                        {% for child in item.children %}
                        <a href="{{ child.url }}" class="block px-4 py-3 hover:bg-milwaukee-gray hover:text-milwaukee-red transition-colors {% if loop.first %}rounded-t-lg{% endif %}{% if loop.last %}rounded-b-lg{% endif %}">
                            {{ child.label }}
                        </a>
                        {% endfor %}
                    </div>
                </div>
                {% else %}
                <a href="{{ item.url }}" class="hover:text-milwaukee-red transition-colors py-2">{{ item.label }}</a>
                {% endif %}
                {% endfor %}
            </div>

            <!-- Mobile Navigation Button -->
            <div class="lg:hidden">
                <button onclick="toggleMenu()" class="p-2" aria-label="Toggle menu">
                    <svg class="w-6 h-6" id="menuIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden lg:hidden pb-6 border-t border-milwaukee-gray mt-2">
            {% for item in navigation.main %}
            {% if item.children %}
            <div class="mobile-dropdown">
                <button onclick="toggleSubmenu(this)" class="flex items-center justify-between w-full py-3 hover:text-milwaukee-red transition-colors">
                    <span>{{ item.label }}</span>
                    <svg class="w-4 h-4 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="hidden pl-4 border-l border-milwaukee-gray ml-2">
                    {% for child in item.children %}
                    <a href="{{ child.url }}" class="block py-2 text-gray-400 hover:text-milwaukee-red transition-colors">{{ child.label }}</a>
                    {% endfor %}
                </div>
            </div>
            {% else %}
            <a href="{{ item.url }}" class="block py-3 hover:text-milwaukee-red transition-colors">{{ item.label }}</a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</nav>
