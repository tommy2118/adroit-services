<div class="py-24 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-milwaukee-black mb-4 text-center">WHAT OUR CLIENTS SAY</h2>
        <p class="text-lg text-gray-600 text-center mb-16 max-w-2xl mx-auto">Don't just take our word for it. Here's what homeowners across Kentucky say about working with Adroit Services.</p>

        <div class="grid md:grid-cols-3 gap-8">
            {% for review in testimonials %}
            <div class="bg-white p-8 rounded-lg shadow-lg hover-lift">
                <!-- Star Rating -->
                <div class="flex mb-4">
                    {% for i in range(0, review.rating) %}
                    <svg class="w-5 h-5 text-milwaukee-red" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    {% endfor %}
                </div>

                <!-- Review Text -->
                <p class="text-gray-700 mb-6 italic">"{{ review.text }}"</p>

                <!-- Reviewer Info -->
                <div class="border-t pt-4">
                    <p class="font-bold text-milwaukee-black">{{ review.name }}</p>
                    <p class="text-sm text-gray-500">{{ review.location }} &bull; {{ review.project }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Review Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "{{ site.title }}",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "{{ testimonials | length }}"
  },
  "review": [
    {% for review in testimonials %}
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "{{ review.name }}"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ review.rating }}"
      },
      "reviewBody": "{{ review.text }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
