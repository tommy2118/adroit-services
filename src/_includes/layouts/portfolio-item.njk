---
layout: layouts/base.njk
---

{% include "partials/breadcrumb.njk" %}

<!-- Hero Section -->
<div class="relative bg-milwaukee-black text-white py-20">
    <div class="absolute inset-0">
        <img src="{{ project.image }}" alt="{{ project.title }}" class="w-full h-full object-cover opacity-30">
    </div>
    <div class="relative max-w-7xl mx-auto px-4">
        <span class="inline-block bg-milwaukee-red text-white text-sm px-4 py-1 rounded-full mb-4 capitalize">{{ project.category }}</span>
        <h1 class="text-5xl font-bold mb-4">{{ project.title }}</h1>
        <p class="text-gray-300">{{ project.location }} &bull; {{ project.completionDate }}</p>
    </div>
</div>

<!-- Content Section -->
<div class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
        <div class="prose prose-lg max-w-none">
            <p class="text-xl text-gray-700 mb-8">{{ project.description }}</p>

            <h2 class="text-2xl font-bold text-milwaukee-black mt-12 mb-4">The Challenge</h2>
            <p class="text-gray-700">{{ project.challenge }}</p>

            <h2 class="text-2xl font-bold text-milwaukee-black mt-12 mb-4">Our Solution</h2>
            <p class="text-gray-700">{{ project.solution }}</p>
        </div>

        <!-- Project Image -->
        <div class="mt-12">
            <img src="{{ project.image }}" alt="{{ project.title }}" class="w-full rounded-lg shadow-lg">
        </div>
    </div>
</div>

<!-- Other Projects -->
<div class="py-16 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-milwaukee-black mb-8 text-center">More Projects</h2>
        <div class="grid md:grid-cols-3 gap-6">
            {% for otherProject in portfolio %}
            {% if otherProject.slug != project.slug %}
            <a href="/portfolio/{{ otherProject.slug }}/" class="group block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow">
                <div class="aspect-video">
                    <img src="{{ otherProject.image }}" alt="{{ otherProject.title }}" class="w-full h-full object-cover">
                </div>
                <div class="p-4">
                    <h3 class="font-bold text-milwaukee-black group-hover:text-milwaukee-red transition-colors">{{ otherProject.title }}</h3>
                    <p class="text-sm text-gray-500">{{ otherProject.location }}</p>
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{% include "partials/cta-banner.njk" %}
