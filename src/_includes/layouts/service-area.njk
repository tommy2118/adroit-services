---
layout: layouts/base.njk
---

{% include "partials/breadcrumb.njk" %}

<!-- Hero Section -->
<div class="py-20 bg-milwaukee-black text-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center mb-4">
            <svg class="w-8 h-8 text-milwaukee-red mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-gray-400">{{ area.county }}</span>
        </div>
        <h1 class="text-5xl font-bold mb-4">{{ area.city }}, {{ area.state }} <span class="text-milwaukee-red">Contractor</span></h1>
        <p class="text-xl text-gray-300 max-w-3xl">Quality home renovation and construction services for {{ area.city }} homeowners.</p>
    </div>
</div>

<!-- Content Section -->
<div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-3 gap-12">
            <!-- Main Content -->
            <div class="lg:col-span-2">
                <h2 class="text-3xl font-bold text-milwaukee-black mb-6">Serving {{ area.city }} with Excellence</h2>
                <p class="text-lg text-gray-700 mb-8">{{ area.description }}</p>

                <h3 class="text-2xl font-bold text-milwaukee-black mb-4">Our Services in {{ area.city }}</h3>
                <div class="grid md:grid-cols-2 gap-4 mb-8">
                    {% for service in services %}
                    <a href="/services/{{ service.slug }}/" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <svg class="w-5 h-5 text-milwaukee-red mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-gray-700">{{ service.title }}</span>
                    </a>
                    {% endfor %}
                </div>

                {% if area.nearbyAreas %}
                <h3 class="text-2xl font-bold text-milwaukee-black mb-4">Also Serving Nearby</h3>
                <div class="flex flex-wrap gap-2">
                    {% for nearby in area.nearbyAreas %}
                    <span class="bg-gray-100 px-4 py-2 rounded-full text-gray-700">{{ nearby }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-gray-100 rounded-lg p-8 sticky top-24">
                    <h3 class="text-xl font-bold text-milwaukee-black mb-4">Get a Free Quote in {{ area.city }}</h3>
                    <p class="text-gray-600 mb-6">Ready to start your project? Contact us for a free consultation and estimate.</p>
                    <a href="/#contact" class="block w-full bg-milwaukee-red text-white text-center px-6 py-4 rounded font-bold hover:bg-red-700 transition-colors">
                        GET FREE QUOTE
                    </a>
                    <div class="mt-6 pt-6 border-t border-gray-300">
                        <p class="text-sm text-gray-600 mb-2">Or call us directly:</p>
                        <a href="tel:+15027512655" class="text-lg font-bold text-milwaukee-black hover:text-milwaukee-red transition-colors">
                            {{ site.phone }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Other Service Areas -->
<div class="py-16 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-milwaukee-black mb-8 text-center">Other Service Areas</h2>
        <div class="grid md:grid-cols-4 gap-4">
            {% for otherArea in serviceAreas %}
            {% if otherArea.slug != area.slug %}
            <a href="/service-areas/{{ otherArea.slug }}/" class="block bg-white rounded-lg p-4 hover:shadow-md transition-shadow text-center">
                <span class="font-medium text-milwaukee-black hover:text-milwaukee-red transition-colors">{{ otherArea.city }}, {{ otherArea.state }}</span>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{% include "partials/cta-banner.njk" %}

<!-- Local Business Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "{{ site.title }} - {{ area.city }}, {{ area.state }}",
  "description": "{{ area.description }}",
  "url": "{{ site.url }}/service-areas/{{ area.slug }}/",
  "telephone": "{{ site.phone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Crestwood",
    "addressRegion": "KY",
    "postalCode": "40014",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{ area.latitude }}",
    "longitude": "{{ area.longitude }}"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ area.city }}, {{ area.state }}"
  },
  "priceRange": "$"
}
</script>

<!-- Geo Meta Tags -->
<meta name="geo.region" content="US-KY">
<meta name="geo.placename" content="{{ area.city }}">
<meta name="geo.position" content="{{ area.latitude }};{{ area.longitude }}">
<meta name="ICBM" content="{{ area.latitude }}, {{ area.longitude }}">
