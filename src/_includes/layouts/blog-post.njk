---
layout: layouts/base.njk
---

{% set breadcrumb = [{label: "Blog", url: "/blog/"}, {label: title}] %}
{% include "partials/breadcrumb.njk" %}

<article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4">
        <!-- Header -->
        <header class="mb-12">
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
                <time datetime="{{ date | date('%Y-%m-%d') }}">{{ date | date('%B %d, %Y') }}</time>
                {% if categories %}
                <span>&bull;</span>
                {% for category in categories %}
                <span class="bg-gray-100 px-3 py-1 rounded-full capitalize">{{ category }}</span>
                {% endfor %}
                {% endif %}
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-milwaukee-black mb-6">{{ title }}</h1>
            {% if description %}
            <p class="text-xl text-gray-600">{{ description }}</p>
            {% endif %}
        </header>

        <!-- Featured Image -->
        {% if image %}
        <div class="mb-12">
            <img src="{{ image }}" alt="{{ title }}" class="w-full rounded-lg shadow-lg">
        </div>
        {% endif %}

        <!-- Content -->
        <div class="prose prose-lg max-w-none">
            {{ content | safe }}
        </div>

        <!-- Author/CTA -->
        <div class="mt-16 pt-8 border-t border-gray-200">
            <div class="bg-gray-100 rounded-lg p-8">
                <h3 class="text-xl font-bold text-milwaukee-black mb-4">Ready to Start Your Project?</h3>
                <p class="text-gray-600 mb-6">Contact Adroit Services today for a free consultation and estimate on your home renovation project.</p>
                <a href="/#contact" class="bg-milwaukee-red text-white px-8 py-4 rounded font-bold hover:bg-red-700 transition-colors inline-block">
                    GET FREE QUOTE
                </a>
            </div>
        </div>
    </div>
</article>

<!-- Related Posts -->
{% set relatedPosts = collections.posts | reject("data.page.url", page.url) | first(3) %}
{% if relatedPosts.length %}
<div class="py-16 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-milwaukee-black mb-8 text-center">More Articles</h2>
        <div class="grid md:grid-cols-3 gap-8">
            {% for post in relatedPosts %}
            {% include "partials/blog-card.njk" %}
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

<!-- Article Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "datePublished": "{{ date | date('%Y-%m-%d') }}",
  "author": {
    "@type": "Organization",
    "name": "{{ site.title }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}"
  }
}
</script>
