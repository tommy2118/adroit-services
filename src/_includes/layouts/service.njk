---
layout: layouts/base.njk
---

{% include "partials/breadcrumb.njk" %}

<!-- Hero Section -->
<div class="relative bg-milwaukee-black text-white py-20">
    <div class="absolute inset-0">
        <img src="{{ service.image }}" alt="{{ service.title }}" class="w-full h-full object-cover opacity-30">
    </div>
    <div class="relative max-w-7xl mx-auto px-4">
        <h1 class="text-5xl font-bold mb-4">{{ service.title }}</h1>
        <p class="text-xl text-gray-300 max-w-2xl">{{ service.shortDescription }}</p>
    </div>
</div>

<!-- Content Section -->
<div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-3 gap-12">
            <!-- Main Content -->
            <div class="lg:col-span-2">
                <h2 class="text-3xl font-bold text-milwaukee-black mb-6">About This Service</h2>
                <p class="text-lg text-gray-700 mb-8">{{ service.fullDescription }}</p>

                <h3 class="text-2xl font-bold text-milwaukee-black mb-4">What's Included</h3>
                <ul class="space-y-3 mb-8">
                    {% for feature in service.features %}
                    <li class="flex items-start">
                        <svg class="w-6 h-6 text-milwaukee-red mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-gray-700">{{ feature }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-gray-100 rounded-lg p-8 sticky top-24">
                    <h3 class="text-xl font-bold text-milwaukee-black mb-4">Ready to Get Started?</h3>
                    <p class="text-gray-600 mb-6">Contact us for a free consultation and estimate on your {{ service.title | lower }} project.</p>
                    <a href="/#contact" class="block w-full bg-milwaukee-red text-white text-center px-6 py-4 rounded font-bold hover:bg-red-700 transition-colors">
                        GET FREE QUOTE
                    </a>
                    <div class="mt-6 pt-6 border-t border-gray-300">
                        <p class="text-sm text-gray-600 mb-2">Or call us directly:</p>
                        <a href="tel:{{ site.phone | replace('(', '') | replace(')', '') | replace(' ', '') | replace('-', '') }}" class="text-lg font-bold text-milwaukee-black hover:text-milwaukee-red transition-colors">
                            {{ site.phone }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Other Services -->
<div class="py-16 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-milwaukee-black mb-8 text-center">Our Other Services</h2>
        <div class="grid md:grid-cols-3 gap-6">
            {% for otherService in services %}
            {% if otherService.slug != service.slug %}
            <a href="/services/{{ otherService.slug }}/" class="group block bg-white rounded-lg p-6 hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-milwaukee-black mb-2 group-hover:text-milwaukee-red transition-colors">{{ otherService.title }}</h3>
                <p class="text-gray-600 text-sm">{{ otherService.shortDescription }}</p>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{% include "partials/cta-banner.njk" %}

<!-- Service Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ service.title }}",
  "description": "{{ service.fullDescription }}",
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "{{ site.title }}",
    "telephone": "{{ site.phone }}",
    "url": "{{ site.url }}"
  },
  "areaServed": {
    "@type": "City",
    "name": "Crestwood, KY"
  }
}
</script>
