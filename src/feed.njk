---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} Blog</title>
  <subtitle>Home renovation tips and insights from Crestwood, KY</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/blog/"/>
  <updated>{% set lastPost = collections.posts | last %}{% if lastPost %}{{ lastPost.date | date("%Y-%m-%dT%H:%M:%SZ") }}{% else %}{{ page.date | date("%Y-%m-%dT%H:%M:%SZ") }}{% endif %}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.title }}</name>
    <email>{{ site.email }}</email>
  </author>
  {%- for post in collections.posts | reverse %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <updated>{{ post.date | date("%Y-%m-%dT%H:%M:%SZ") }}</updated>
    <id>{{ site.url }}{{ post.url }}</id>
    <content type="html">{{ post.data.description }}</content>
  </entry>
  {%- endfor %}
</feed>
